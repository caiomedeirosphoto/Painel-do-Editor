rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // conta do Claude que manda os registros do ClickUp para o painel
    function ehRobo() { return request.auth != null && request.auth.token.email == 'robo@painel-do-editor.app'; }

    match /users/{uid}/{document=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/meses/{mes} { allow read: if request.auth != null; }
    match /equipe/{uid} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == uid; }

    // caixa de entrada: o Claude deixa o registro, só o editor dono pega e apaga
    match /entrada/{id} {
      allow create, update: if ehRobo() && request.resource.data.para is string;
      allow read, delete: if request.auth != null && (resource.data.para == request.auth.uid || ehRobo());
    }
    // índice dos cards do ClickUp já registrados (só o Claude usa)
    match /clickup/{id} { allow read, write: if ehRobo(); }
  }
}
